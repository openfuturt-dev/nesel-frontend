APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Search engine indexing. Keep false locally and on staging; production must
# explicitly set SEO_INDEXING_ENABLED=true. APP_URL (no trailing slash) is the
# source of canonical, sitemap, robots.txt and structured-data URLs.
SEO_INDEXING_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CONTACT_FROM_EMAIL="contact@ne-sel.com"
CONTACT_RECIPIENT_EMAIL="majd.chraibi@gmail.com"
SMTP_HOST="mail.ne-sel.com"
SMTP_PORT=465
SMTP_USER="contact@ne-sel.com"
SMTP_PASSWORD=
SMTP_TIMEOUT=10

# Reverse proxies allowed to set X-Forwarded-* headers (comma-separated IPs or
# CIDR ranges). Leave empty unless the site is behind a known proxy or CDN.
TRUSTED_PROXIES=

# StartEntreprise CRM: contact requests become prospects in "Suivi commercial".
# Credentials come from StartEntreprise > Paramètres > Intégrations API (scope
# commercial:leads:write) and must only ever live in this server-side file.
# SYNC_FROM is an ISO-8601 instant: requests created before it are not sent
# automatically (see contact-requests:crm-backfill). Leave disabled until ready.
STARTENTREPRISE_LEADS_ENABLED=false
STARTENTREPRISE_API_URL=https://api.startentreprise.ma
STARTENTREPRISE_TOKEN_URL=
STARTENTREPRISE_CLIENT_ID=
STARTENTREPRISE_CLIENT_SECRET=
STARTENTREPRISE_LEADS_SYNC_FROM=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
